# Variables de entorno del backend. Copia este archivo a .env (en la raíz) y cambia los valores.
# Los valores de abajo son EJEMPLOS ficticios para desarrollo, nunca datos reales. Encima de cada
# variable se indica qué poner en producción (documentacion/guia-de-instalacion.md, paso 7).
# Nunca subas .env al repositorio ni escribas aquí contraseñas o claves de verdad.
# El .env solo se lee al arrancar: después de cambiarlo, reiniciar la aplicación.

# --- Entorno ------------------------------------------------------------------------------------
# development o production. Producción: production.
APP_ENV=development
# Escucha de Waitress con `python -m app.servir` (ADR 0009).
# HOST es una IP local del servidor (IPv4 o IPv6, sin puerto); 0.0.0.0 escucha en todas
# las interfaces IPv4. PORT: 1 a 65535. Vacíos: 0.0.0.0 y 2905.
# Si cambias PORT, ajusta APP_URL y la regla del cortafuegos.
# `flask run` en desarrollo sigue usando su configuración propia (puerto 5000).
HOST=0.0.0.0
PORT=2905

# --- Base de datos PostgreSQL 18 (ADR 0003) -----------------------------------------------------
# Producción: los datos de la base de datos creada para ReMate (guía de instalación, paso 6).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=remate
DB_USER=remate
DB_PASSWORD=cambia-esta-contrasena

# --- Carpetas -----------------------------------------------------------------------------------
# Adjuntos, correos y pedidos SAP (va en las copias de seguridad). Ruta absoluta o relativa a la
# raíz. Producción: C:\ReMate\archivos
ARCHIVOS_DIR=./archivos
# Frontend compilado (npm run build) que sirve Flask. Vacío: frontend/dist. Producción: vacío.
FRONTEND_DIST=

# --- OpenAI (CU-002, CU-004, CU-005; ADR 0011) --------------------------------------------------
# API de OpenAI (Responses API), directamente, sin OpenRouter, en desarrollo y en producción: lee
# las ofertas (CU-004) y propone el correo de petición (CU-002) y los textos de la adjudicación
# (CU-005). La comparativa la calcula el código. Sin clave o modelo, la aplicación sigue
# funcionando: los datos de las ofertas se escriben a mano y los textos los propone el código.
# Producción: clave del proyecto de OpenAI guardada únicamente en el .env del servidor.
IA_API_KEY=pon-aqui-tu-clave
# Modelo de OpenAI: gpt-5-mini con razonamiento low.
# Si alguna oferta se lee mal, se puede probar gpt-5.
IA_MODELO=gpt-5-mini
# Cuánto razona el modelo en cada petición: none, minimal, low, medium, high, xhigh o max
# (cada modelo admite algunos; la familia GPT-5 admite minimal). Se paga como salida: menos
# razonamiento, más barato, pero puede leer peor. Vacío: low.
IA_RAZONAMIENTO=low

# --- Correo saliente: recordatorio de entrega (CU-009, `flask enviar-recordatorios`) --------------
# Sin SMTP_HOST no se envía nada (en desarrollo se puede probar con `--prueba`).
# Puerto 465: SSL. Otro puerto con SMTP_SECURE=true: STARTTLS (lo habitual con el 587).
# SMTP_USER y SMTP_PASSWORD pueden quedar vacíos si el servidor no pide usuario; si lo pide, la
# conexión tiene que ir cifrada. Producción: los datos del servidor de correo de la empresa.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=remate@ejemplo.com
SMTP_PASSWORD=cambia-esta-contrasena
SMTP_SECURE=true
SMTP_FROM=ReMate <remate@ejemplo.com>

# Dirección con la que se entra a la aplicación: enlace de los recordatorios y de los avisos
# del pedido SAP y la única (con localhost y HOSTS_PERMITIDOS) a la que atiende ReMate
# (protección frente a DNS rebinding). Imprescindible en producción. Vacío: los correos van sin
# enlace y no se comprueba la dirección (desarrollo).
# Producción: la dirección con la que entran los usuarios, por ejemplo http://<ip_servidor>:2905
# o, con un proxy inverso delante (ADR 0016), su nombre: http://remate.empresa.local
APP_URL=

# Nombre de la empresa: firma de los correos a proveedores y textos para la IA (opcional).
EMPRESA_NOMBRE=Empresa Ejemplo

# Modo admin (ADR 0015): se abre con el enlace «admin» del pie de página. Aquí va el
# hash de la contraseña, nunca la contraseña: se genera con `flask --app app clave-admin` dentro
# de backend/. Entre comillas simples. Vacío: el modo admin está desactivado.
# En producción, el hash se genera en otro equipo y solo se copia el hash al servidor: la
# contraseña no llega al servidor.
ADMIN_CLAVE_HASH=
# Carpeta de las copias de seguridad, para ver la última en el modo admin (opcional).
# Producción: C:\ReMate\copias
COPIAS_DIR=
# Otros nombres o IP con los que se entra a ReMate, separados por comas (opcional). Con APP_URL
# puesta, ReMate solo atiende a la dirección de APP_URL, a localhost y a estos (protección
# frente a DNS rebinding). Vacío: solo APP_URL y localhost.
HOSTS_PERMITIDOS=
# IP desde la que se conecta el proxy inverso (por ejemplo Caddy, ADR 0016), del que se aceptan
# X-Forwarded-For y X-Forwarded-Proto (opcional). Si el proxy está en el mismo servidor y se
# conecta a la IP de HOST, la misma IP aquí. Vacío: sin proxy.
PROXY_DE_CONFIANZA=
